}
// 単一ノードをシリアライズ
function shSone(c){
  var t=c.tagName.toLowerCase();
  if(t==='p') return '<p>'+shS(c)+'</p>\n';
  if(t==='table'){
    var at=''; ['cellspacing','cellpadding','border','align','width','bordercolor'].forEach(function(x){ var v=c.getAttribute(x); if(v!==null) at+=' '+x+'="'+v+'"' });
    return '<table'+at+'>\n'+shS(c)+'</table>\n';
  }
  return shS(c);
}

// ===================== 楽天商品説明文用 =====================
function extractItemInfo(html){
  const doc=new DOMParser().parseFromString(html,'text/html'), b=doc.body;
  const info={itemNo:'',seisaku:'',material:'',size:'',color:''};
  // 商品番号：タイトル strong 内の [XXX]
  b.querySelectorAll('div[align="center"] strong, strong').forEach(function(s){
    if(/font-size\s*:\s*18px/i.test(s.getAttribute('style')||'')){
      const m=s.textContent.match(/\[([A-Z][A-Z0-9-]+)\]/i);
      if(m&&!info.itemNo) info.itemNo=m[1];
    }
  });
  // スペックテーブル
  b.querySelectorAll('table').forEach(function(t){
    if(t.getAttribute('cellpadding')==='10'&&t.getAttribute('cellspacing')==='5'){
      t.querySelectorAll('tr').forEach(function(row){
        const cells=row.querySelectorAll('td');
        if(cells.length>=2){
          const label=cells[0].textContent.trim();
          const valH=cells[1].innerHTML.trim(), valT=cells[1].textContent.trim();
          if(/素材|機能/.test(label)) info.material=valH;
          else if(/サイズ/.test(label)) info.size=valH;
          else if(/カラー/.test(label)) info.color=valT;
          else if(/制作地/.test(label)) info.seisaku=valT;
        }
      });
    }
  });
  return info;
}

function extractBrandText(html){
  const doc=new DOMParser().parseFromString(html,'text/html'), b=doc.body;
