</style>
<script>
let O={sp:'',yahoo:'',shopify:'',desc:''},cur='sp',curF='chars',pcHTML='';

// プラットフォーム別文字数上限（全角テキスト）
const LIMITS={
  sp:     {name:'楽天SP',      textLimit:5120},
  yahoo:  {name:'Yahoo',       textLimit:null},
  shopify:{name:'Shopify',     textLimit:null},
  desc:   {name:'楽天商品説明文', textLimit:null}
};
// 入力PC用HTMLの文字数上限
const PC_TEXT_LIMIT=5120;

function go(){
  const h=document.getElementById('iH').value.trim();
  if(!h){alert('HTMLを入力してください');return}
  pcHTML=h;
  O.sp=toSP(h); O.yahoo=toYahoo(h); O.shopify=toShopify(h);

  // 商品説明文：スペック自動抽出・ブランド紹介文プリセット
  const info=extractItemInfo(h);
  document.getElementById('descSeisaku').value=info.seisaku||'';
  document.getElementById('descPrText').value=extractBrandText(h);
  O.desc=toDesc(h, info.seisaku, document.getElementById('descPrText').value);

  // 楽天PC入力の文字数チェック（タグ除くテキスト）
  const pcTextLen=countText(h);
  if(pcTextLen>PC_TEXT_LIMIT){
    alert('⚠ 楽天PC用のテキストが上限を超えています。\n現在：'+pcTextLen.toLocaleString()+'文字\n上限：'+PC_TEXT_LIMIT.toLocaleString()+'文字（全角）');
  }

  document.getElementById('oB').style.display='block';
  show(); updateFeature();
}

function show(){ document.getElementById('oH').value=O[cur] }

function sw(t,el){
  cur=t;
  document.querySelectorAll('#tabs>div').forEach(d=>d.classList.remove('act'));
  el.classList.add('act');
  document.getElementById('descExtras').style.display=(t==='desc')?'block':'none';
  show(); updateFeature();
}

function regenDesc(){
  if(!pcHTML) return;
  O.desc=toDesc(pcHTML, document.getElementById('descSeisaku').value, document.getElementById('descPrText').value);
  if(cur==='desc') show();
}

function swF(f,el){
  curF=f;
  document.querySelectorAll('#ftabs>div').forEach(d=>d.classList.remove('act'));
  el.classList.add('act');
  ['Chars','Links','Preview'].forEach(function(n){
    document.getElementById('f'+n).style.display='none';
  });
  document.getElementById('f'+f.charAt(0).toUpperCase()+f.slice(1)).style.display='block';
  updateFeature();
}

function updateFeature(){
  if(curF==='chars') showChars();
  else if(curF==='links') showLinks();
  else if(curF==='preview') showPreview();
}

// 楽天方式の文字数カウント（HTMLタグ含む・全角=1・半角=0.5・タブ=0.5・改行=0.5・その他制御文字=0）
function countText(html){
  let count=0;
  for(let i=0;i<html.length;i++){
    const c=html.charCodeAt(i);
    // CR+LF → 改行1つとして0.5
    if(c===0x0D && i+1<html.length && html.charCodeAt(i+1)===0x0A){ count+=0.5; i++; continue }
    // 改行（LF or CR）→ 0.5
    if(c===0x0A||c===0x0D){ count+=0.5; continue }
    // タブ → 0.5（半角扱い）
    if(c===0x09){ count+=0.5; continue }
    // その他制御文字（0x00〜0x1F）→ カウントしない
    if(c<0x0020){ continue }
    // 半角（ASCII印字可能文字 U+0020〜U+007E）→ 0.5
    if(c<=0x007E){ count+=0.5; continue }
    // 半角カタカナ（U+FF61〜U+FF9F）→ 0.5
    if(c>=0xFF61&&c<=0xFF9F){ count+=0.5; continue }
    // 全角 → 1
    count+=1;
  }
  return Math.ceil(count);
}

// --- 文字数カウント ---
function stripTags(html){ return html.replace(/<[^>]*>/g,'').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>') }

function showChars(){
  const html=O[cur];
  const htmlLen=html.length;
  const textLen=countText(html);
  const pcTextLen=countText(pcHTML);
  const lim=LIMITS[cur];
  const hasLimit=!!lim.textLimit;
  const spOver=hasLimit && textLen>lim.textLimit;
  const pcOver=pcTextLen>PC_TEXT_LIMIT;

  let out='<table style="font-size:13px;border-collapse:collapse;width:100%">';
  out+='<tr style="background:#f5f5f5">'
    +'<th style="padding:6px 10px;text-align:left;font-weight:600">プラットフォーム</th>'
    +'<th style="padding:6px 10px;text-align:right;font-weight:600">文字数（全角換算）</th>'
    +'<th style="padding:6px 10px;text-align:right;font-weight:600">上限</th>'
    +'<th style="padding:6px 10px;text-align:left;font-weight:600">状態</th></tr>';

  // 楽天PC用（入力元）
  out+='<tr style="border-bottom:1px solid #eee">';
  out+='<td style="padding:6px 10px">楽天PC用（入力）</td>';
  out+='<td style="padding:6px 10px;text-align:right;font-family:monospace;'+(pcOver?'color:#c00;font-weight:700':'')+'">'+pcTextLen.toLocaleString()+'</td>';
  out+='<td style="padding:6px 10px;text-align:right;color:#888">'+PC_TEXT_LIMIT.toLocaleString()+'</td>';
  out+='<td style="padding:6px 10px"><span class="'+(pcOver?'warn':'ok')+'">'+(pcOver?'⚠ 上限超過':'✓ OK')+'</span></td></tr>';

  // 変換後（現在のタブ）
  out+='<tr style="border-bottom:1px solid #eee">';
  out+='<td style="padding:6px 10px">'+lim.name+'（変換後）</td>';
  out+='<td style="padding:6px 10px;text-align:right;font-family:monospace;'+(spOver?'color:#c00;font-weight:700':'')+'">'+textLen.toLocaleString()+'</td>';
  out+='<td style="padding:6px 10px;text-align:right;color:#888">'+(hasLimit?lim.textLimit.toLocaleString():'—')+'</td>';
  out+='<td style="padding:6px 10px"><span class="'+(spOver?'warn':hasLimit?'ok':'')+'">'+( spOver?'⚠ 上限超過':hasLimit?'✓ OK':'—')+'</span></td></tr>';

  // HTML全体（参考）
  out+='<tr style="border-bottom:1px solid #eee">';
  out+='<td style="padding:6px 10px;color:#aaa">'+lim.name+' HTML全体（タグ含む・参考）</td>';
  out+='<td style="padding:6px 10px;text-align:right;font-family:monospace;color:#aaa">'+htmlLen.toLocaleString()+'</td>';
  out+='<td style="padding:6px 10px;text-align:right;color:#aaa">—</td>';
  out+='<td style="padding:6px 10px;color:#aaa">参考値</td></tr>';

  out+='</table>';

  // 超過メッセージ
  if(pcOver){
    const ex=pcTextLen-PC_TEXT_LIMIT;
    out+='<div style="margin-top:10px;padding:10px 14px;background:#fff0f0;border:1px solid #ffcccc;border-radius:6px;font-size:13px;color:#c00">';
    out+='⚠ 楽天PC用が上限（'+PC_TEXT_LIMIT.toLocaleString()+'文字）を <strong>'+ex.toLocaleString()+'文字</strong> 超過しています。</div>';
  }
  if(spOver){
    const ex=textLen-lim.textLimit;
    out+='<div style="margin-top:8px;padding:10px 14px;background:#fff0f0;border:1px solid #ffcccc;border-radius:6px;font-size:13px;color:#c00">';
    out+='⚠ '+lim.name+'が上限（'+lim.textLimit.toLocaleString()+'文字）を <strong>'+ex.toLocaleString()+'文字</strong> 超過しています。</div>';
  }

  out+='<p style="font-size:11px;color:#aaa;margin-top:8px">※全角=1文字、半角=0.5文字で換算。楽天PC・SP用は全角5,120文字以内。</p>';
  document.getElementById('charInfo').innerHTML=out;

  if(spOver){
    setTimeout(function(){ alert('⚠ '+lim.name+'のテキストが上限を超えています。\n現在：'+textLen.toLocaleString()+'文字\n上限：'+lim.textLimit.toLocaleString()+'文字（全角換算）') },100);
  }
}

// --- リンクURL一覧 ---
function showLinks(){
  const html=O[cur];
  const tmp=new DOMParser().parseFromString(html,'text/html');
  const links=tmp.querySelectorAll('a[href]');
  let out='';
  if(links.length===0){ document.getElementById('linkList').innerHTML='<p style="color:#aaa;font-size:13px">リンクURLが見つかりませんでした。</p>'; return }
  out+='<p style="font-size:12px;color:#888;margin-bottom:8px">リンク '+links.length+'件</p>';
  links.forEach(function(a,i){
    const href=a.getAttribute('href')||'';
    const hasImg=!!a.querySelector('img');
    const txt=a.textContent.trim().substring(0,40)||(hasImg?'[画像リンク]':'');
    out+='<div class="url-item">';
    out+='<span style="color:#aaa;margin-right:6px">'+(i+1)+'.</span>';
    out+='<a href="'+href+'" target="_blank">'+href+'</a>';
    out+='<button class="url-copy" onclick="cpText(\''+href.replace(/\\/g,'\\\\').replace(/'/g,"\\'")+'\'  )">コピー</button>';
    if(txt) out+='<span style="color:#aaa;font-size:11px;margin-left:8px">'+txt+'</span>';
    out+='</div>';
  });
  document.getElementById('linkList').innerHTML=out;
}

// テキストコピー
function cpText(t){
  const ta=document.createElement('textarea');
  ta.value=t; document.body.appendChild(ta); ta.select(); document.execCommand('copy');
  document.body.removeChild(ta); alert('コピーしました');
}

// --- プレビュー ---
function showPreview(){
  const frame=document.getElementById('previewFrame');
  const html='<!DOCTYPE html><html><head><meta charset="utf-8"><style>body{font-family:sans-serif;font-size:14px;line-height:1.8;padding:16px;max-width:660px;margin:0 auto}img{max-width:100%;height:auto}table{max-width:100%}center{display:block;text-align:center}</style></head><body>'+O[cur]+'</body></html>';
  frame.srcdoc=html;
}

function cp(){ document.getElementById('oH').select(); document.execCommand('copy'); const m=document.getElementById('cm'); m.textContent='コピーしました！'; setTimeout(()=>m.textContent='',2000) }

// --- ユーティリティ ---
function exS(el,p){ const s=el.getAttribute('style')||'',m=s.match(new RegExp(p+'\\s*:\\s*([^;]+)','i')); return m?m[1].trim():null }

function isHd(t){
  const r=t.querySelectorAll(':scope>tbody>tr,:scope>tr');
  if(r.length!==1) return false;
  const c=r[0].querySelectorAll('td,th');
  if(c.length!==1) return false;
  const d=c[0];
  return !!(d.getAttribute('bgcolor')||exS(d,'background-color')) && !!d.querySelector('font[color]');
}

function isLay(t){
  if(isHd(t)) return false;
  const w=t.getAttribute('width'), cp=t.getAttribute('cellpadding'), b=t.getAttribute('border'), cs=t.getAttribute('cellspacing');
  if(cp==='10'&&cs==='5') return false;
  if((w==='660'||w==='650')&&(!cp||cp==='0')) return true;
  if(b==='0'&&cs==='0') return true;
  // width="600" で border/cellspacing が省略されているラッパーテーブル
  if(w==='600'&&b===null&&cs===null&&(!cp||cp==='0')) return true;
  return false;
}

// 全行・全セルの中身を取り出し、複数行なら行間に<br><br>挿入
function uwT(t){
  const p=t.parentNode, d=t.ownerDocument;
  const rows=t.querySelectorAll(':scope>tbody>tr,:scope>tr');
  const multi=rows.length>1;
  rows.forEach(function(row){
    const cells=row.querySelectorAll(':scope>td,:scope>th');
    for(const c of cells){ while(c.firstChild) p.insertBefore(c.firstChild,t) }
    if(multi){ p.insertBefore(d.createElement('br'),t); p.insertBefore(d.createElement('br'),t) }
  });
  t.remove();
}

function rmTi(r){
  r.querySelectorAll('div[align="center"]').forEach(function(d){
    const s=d.querySelector('strong');
    if(s && /\[[A-Za-z0-9][-A-Za-z0-9]*\]/.test(s.textContent)){
      let n=d.nextSibling;
      while(n&&((n.nodeType===1&&n.tagName==='BR')||(n.nodeType===3&&!n.textContent.trim()))){ const x=n; n=n.nextSibling; x.remove() }
      d.remove();
    }
  });
}

function rmOr(r){
  ['tbody','tr','td'].forEach(function(tag){
    r.querySelectorAll(tag).forEach(function(el){
      if(!el.closest('table')){ while(el.firstChild) el.parentNode.insertBefore(el.firstChild,el); el.remove() }
    });
  });
}

function rmDot(r){
  r.querySelectorAll('td[valign="top"]').forEach(function(td){ if(td.textContent.trim()==='・') td.remove() });
}

function rmLay(r){
  let a=true;
  while(a){ a=false; r.querySelectorAll('table').forEach(function(t){ if(isLay(t)){ uwT(t); a=true } }) }
}

// Shopify用：レイアウトテーブル展開時に中身を<p>で囲む（画像のみセル・画像のみdivは削除）
function uwTSh(t){
  const p=t.parentNode, d=t.ownerDocument;
  const rows=t.querySelectorAll(':scope>tbody>tr,:scope>tr');
  const multi=rows.length>1;
  const pEl=d.createElement('p');
  rows.forEach(function(row){
    const cells=row.querySelectorAll(':scope>td,:scope>th');
    const multiCol=cells.length>1;
    cells.forEach(function(c){
      // 複数カラムで画像のみのセルは削除
      if(multiCol && c.querySelector('img') && !c.textContent.trim()){
        return;
      }
      // 複数カラムのテキストセル内にある画像のみのdiv/centerも削除
      if(multiCol){
        c.querySelectorAll('div[align="center"], center').forEach(function(el){
          if(el.querySelector('img') && !el.textContent.trim()){
            el.remove();
          }
        });
      }
      while(c.firstChild) pEl.appendChild(c.firstChild);
    });
    if(multi){ pEl.appendChild(d.createElement('br')); pEl.appendChild(d.createElement('br')) }
  });
  p.insertBefore(pEl, t);
  t.remove();
}

function rmLaySh(r){
  let a=true;
  while(a){ a=false; r.querySelectorAll('table').forEach(function(t){ if(isLay(t)){ uwTSh(t); a=true } }) }
}

// SP用：レイアウトテーブル展開（2カラム対応）
function uwTShSP(t){
  const p=t.parentNode, d=t.ownerDocument;
  const rows=t.querySelectorAll(':scope>tbody>tr,:scope>tr');
  const multiRow=rows.length>1;
  rows.forEach(function(row){
    const cells=row.querySelectorAll(':scope>td,:scope>th');
    const multiCol=cells.length>1;
    if(multiCol){
      cells.forEach(function(cell){
        const hasOnlyImg=cell.querySelector('img')&&!cell.textContent.trim();
        if(hasOnlyImg){
          // 画像のみセルはSPでは削除
        } else {
          const pEl=d.createElement('p');
          while(cell.firstChild) pEl.appendChild(cell.firstChild);
          p.insertBefore(pEl,t);
          p.insertBefore(d.createElement('br'),t);
          p.insertBefore(d.createElement('br'),t);
        }
      });
    } else {
      const pEl=d.createElement('p');
      const cell=cells[0];
      if(cell){ while(cell.firstChild) pEl.appendChild(cell.firstChild) }
      p.insertBefore(pEl,t);
      if(multiRow){ p.insertBefore(d.createElement('br'),t); p.insertBefore(d.createElement('br'),t) }
    }
  });
  t.remove();
}

function rmLayShSP(r){
  let a=true;
  while(a){ a=false; r.querySelectorAll('table').forEach(function(t){ if(isLay(t)){ uwTShSP(t); a=true } }) }
}

function cBr(h){
  h=h.replace(/(<br\s*\/?>[\s\n]*){3,}/gi,'<br><br>');
  h=h.replace(/^(\s*<br\s*\/?>[\s\n]*)+/i,'');
  h=h.replace(/(\s*<br\s*\/?>[\s\n]*)+$/i,'');
  return h.replace(/[ \t]+\n/g,'\n').replace(/\n{3,}/g,'\n\n').trim();
}

function gHT(fe){
  let t='';
  (function w(n){ for(const c of n.childNodes){
    if(c.nodeType===3) t+=c.textContent;
    else if(c.nodeType===1){ const g=c.tagName.toLowerCase(); if(g==='strong'||g==='b') w(c); else if(g==='br') t+='<br>'; else w(c) }
  }})(fe);
  return t.trim();
}

// ===================== 楽天SP用 =====================
function toSP(html){
  const doc=new DOMParser().parseFromString(html,'text/html'), b=doc.body;

  // strong color:#C00 → <font color="#CC0000"><b>...</b></font>
  b.querySelectorAll('strong').forEach(function(s){
    if(/color\s*:\s*#C00/i.test(s.getAttribute('style')||'')){
      const f=doc.createElement('font'); f.setAttribute('color','#CC0000');
      const bb=doc.createElement('b');
      while(s.firstChild) bb.appendChild(s.firstChild);
      f.appendChild(bb);
      s.replaceWith(f);
    }
  });

  rmTi(b);

  // 見出しテーブル統一（SP用：border/bordercolor/cellspacing なし）
  b.querySelectorAll('table').forEach(function(t){
    if(!isHd(t)) return;
    const c=t.querySelector('td,th');
    const bg=c.getAttribute('bgcolor')||exS(c,'background-color')||'#006666';
    const fe=c.querySelector('font[color]'), fc=fe?fe.getAttribute('color'):'#FFFFFF';
    const tx=gHT(fe);
    const nt=doc.createElement('table');
    nt.setAttribute('cellpadding','12'); nt.setAttribute('width','100%'); nt.setAttribute('align','center');
    nt.innerHTML='<tr><td bgcolor="'+bg+'">\n<font color="'+fc+'">\n'+tx+'\n</font>\n</td></tr>';
    t.replaceWith(nt);
  });

  // スペックテーブル：width="660"→"100%"、<strong>タグ除去
  b.querySelectorAll('table').forEach(function(t){
    var cp=t.getAttribute('cellpadding'), cs=t.getAttribute('cellspacing'), w=t.getAttribute('width');
    if(cp==='10'&&cs==='5'&&w==='660'){
      t.setAttribute('width','100%');
      t.querySelectorAll('strong').forEach(function(s){
        while(s.firstChild) s.parentNode.insertBefore(s.firstChild,s);
        s.remove();
      });
    }
  });

  rmDot(b); rmLayShSP(b); rmOr(b);
  return cBr(spS(b));
}

// SP用：<div align="center">を画像=center、テキスト(p)=左寄せに分離
function spSerDiv(div){
  var o='', buf='';
  for(var i=0;i<div.childNodes.length;i++){
    var ch=div.childNodes[i];
    if(ch.nodeType===3){ buf+=ch.textContent; continue }
    if(ch.nodeType!==1) continue;
    var tag=ch.tagName.toLowerCase();
    // <p>(展開されたテキスト段落)やtableはcenterの外に出す
    if(tag==='p'||tag==='table'){
      if(buf.trim()){ o+='<center>\n'+buf+'\n</center>\n'; buf=''; }
      // SPではpタグ自体は出さず中身のみ出力
      if(tag==='p'){ o+=spS(ch)+'\n' }
      else {
        var at=''; ['width','align','border','cellpadding','cellspacing','bordercolor'].forEach(function(x){ var v=ch.getAttribute(x); if(v!==null) at+=' '+x+'="'+v+'"' });
        o+='<table'+at+'>\n'+spS(ch)+'</table>\n';
      }
      continue;
    }
    if(tag==='img'){ buf+='<img src="'+(ch.getAttribute('src')||'')+'" alt="" width="100%">'; continue }
    if(tag==='a'){ buf+='<a href="'+(ch.getAttribute('href')||'#')+'"'+(ch.getAttribute('target')==='_blank'?' target="_blank"':'')+'>'+spS(ch)+'</a>'; continue }
    if(tag==='br'){ buf+='<br>'; continue }
    if(tag==='tbody'||tag==='span'){ buf+=spS(ch); continue }
    buf+=spS(ch);
  }
  if(buf.trim()){ o+='<center>\n'+buf+'\n</center>\n'; }
  return o;
}

function spS(n){
  let o='';
  for(const c of n.childNodes){
    if(c.nodeType===3){ o+=c.textContent; continue }
    if(c.nodeType!==1) continue;
    const t=c.tagName.toLowerCase();
    if(t==='tbody'||t==='span'){ o+=spS(c); continue }
    if(['script','style','head','meta','link'].indexOf(t)>=0) continue;
    if(t==='br'||t==='hr'){ o+='<'+t+'>'; continue }
    if(t==='div'){
      const a=(c.getAttribute('align')||'').toLowerCase();
      if(a==='center'){ o+=spSerDiv(c) } else { o+=spS(c) }
      continue;
    }
    if(t==='img'){ o+='<img src="'+(c.getAttribute('src')||'')+'" alt="" width="100%">'; continue }
    if(t==='a'){
      o+='<a href="'+(c.getAttribute('href')||'#')+'"'+(c.getAttribute('target')==='_blank'?' target="_blank"':'')+'>'+spS(c)+'</a>';
      continue;
    }
    if(t==='table'){
      var at=''; ['width','align','border','cellpadding','cellspacing','bordercolor'].forEach(function(x){ var v=c.getAttribute(x); if(v!==null) at+=' '+x+'="'+v+'"' });
      o+='<table'+at+'>\n'+spS(c)+'</table>'; continue;
    }
    if(t==='tr'){ o+='<tr>\n'+spS(c)+'</tr>\n'; continue }
    if(t==='td'||t==='th'){
      var at=''; ['bgcolor','align','valign','width','colspan','rowspan'].forEach(function(x){ var v=c.getAttribute(x); if(v!==null) at+=' '+x+'="'+v+'"' });
      o+='<'+t+at+'>'+spS(c)+'</'+t+'>\n'; continue;
    }
    if(t==='font'){
      var fc=c.getAttribute('color')||'';
      // #666666（グレー）はSPでは除去して中身のみ
      if(fc.replace('#','').toLowerCase()==='666666'){ o+=spS(c); continue }
      var at=''; ['color','size'].forEach(function(x){ var v=c.getAttribute(x); if(v!==null) at+=' '+x+'="'+v+'"' });
      o+='<font'+at+'>'+spS(c)+'</font>'; continue;
    }
    if(t==='strong'){ o+='<b>'+spS(c)+'</b>'; continue }
    if(t==='center'){ o+='<center>\n'+spS(c)+'\n</center>'; continue }
    if(t==='p'){ o+=spS(c); continue }
    if(['b','em','i','u','s','h1','h2','h3','h4','h5','h6','ul','ol','li'].indexOf(t)>=0){
      o+='<'+t+'>'+spS(c)+'</'+t+'>'; continue;
    }
    o+=spS(c);
  }
  return o;
}

