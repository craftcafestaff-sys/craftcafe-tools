</div>
</div>
<style>
.fpanel{ padding:12px 0 }
#charInfo span.ok{ color:#006666;font-weight:600 }
#charInfo span.warn{ color:#c00;font-weight:600 }
.url-item{ font-size:12px;padding:4px 0;border-bottom:1px solid #f0f0f0;word-break:break-all }
.url-item a{ color:#006666;text-decoration:none }
.url-item a:hover{ text-decoration:underline }
